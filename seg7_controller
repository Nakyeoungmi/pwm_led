`timescale 1ns / 1ps
module seg7_controller(
    input clk,
    input rst,
    input [11:0] bcd,
    output reg [7:0] seg,
    output reg [7:0] seg_sel
    );

    reg [3:0] digit;
    reg [2:0] scan = 0;

    always @(posedge clk or posedge rst) begin
        if (rst)
            scan <= 0;
        else
            scan <= scan + 1;
    end

    always @(*) begin
        case (scan)
            3'd0: begin digit = bcd[3:0];  seg_sel = 8'b11111110; end
            3'd1: begin digit = bcd[7:4];  seg_sel = 8'b11111101; end
            3'd2: begin digit = bcd[11:8]; seg_sel = 8'b11111011; end
            default: begin digit = 0; seg_sel = 8'b11111111; end
        endcase
    end

    always @(*) begin
        case (digit)
            4'd0: seg = 8'b00111111;
            4'd1: seg = 8'b00000110;
            4'd2: seg = 8'b01011011;
            4'd3: seg = 8'b01001111;
            4'd4: seg = 8'b01100110;
            4'd5: seg = 8'b01101101;
            4'd6: seg = 8'b01111101;
            4'd7: seg = 8'b00000111;
            4'd8: seg = 8'b01111111;
            4'd9: seg = 8'b01101111;
            default: seg = 8'b00000000;

        endcase
    end
endmodule
